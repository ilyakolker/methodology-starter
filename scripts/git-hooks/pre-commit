#!/usr/bin/env bash
# scripts/git-hooks/pre-commit
#
# Blocks commits that introduce CHANGELOG.md entries with dates earlier
# than the project's first commit. Mechanical guard against fabricated
# "narrative" dates an agent (or human) might invent without checking git.
#
# Activation:
#   git config core.hooksPath scripts/git-hooks
# (init.sh handles this idempotently.)
#
# Behavior:
#   - Only inspects CHANGELOG.md. Other files pass through.
#   - Only flags NEW lines (added in this commit). Pre-existing fake
#     entries are not touched here — separate cleanup.
#   - Silent on success. Loud on rejection.

set -euo pipefail

# ----- Skip cleanly if not in a repo with commits yet -----
# `git log` exits non-zero on an empty repo. No baseline => nothing to enforce.
FIRST_COMMIT_DATE="$(git log --reverse --format=%cs 2>/dev/null | head -1 || true)"
if [[ -z "${FIRST_COMMIT_DATE}" ]]; then
  exit 0
fi

# ----- Bail out fast if CHANGELOG.md is not part of this commit -----
# `--name-only` lists only paths in the staged diff. Empty => nothing to check.
if ! git diff --cached --name-only | grep -qx 'CHANGELOG.md'; then
  exit 0
fi

# ----- Extract NEW dated headings added in this commit -----
# -U0 strips context so we only see + lines that are truly added.
# We exclude the diff header `+++ b/CHANGELOG.md` by anchoring on `^\+## `.
# `|| true` keeps `set -e` happy when grep finds nothing.
ADDED_HEADINGS="$(
  git diff --cached --no-color -U0 -- CHANGELOG.md \
    | grep -E '^\+## \[[0-9]{4}-[0-9]{2}-[0-9]{2}\]' \
    || true
)"

if [[ -z "${ADDED_HEADINGS}" ]]; then
  exit 0
fi

# ----- Compare each added date against the floor -----
OFFENDERS=()
while IFS= read -r line; do
  # Strip the leading `+## [` and trailing `]...` to isolate YYYY-MM-DD.
  DATE="$(printf '%s' "$line" | sed -E 's/^\+## \[([0-9]{4}-[0-9]{2}-[0-9]{2})\].*$/\1/')"
  if [[ -z "$DATE" ]]; then
    continue
  fi
  # String compare works for ISO dates (YYYY-MM-DD is lexicographically ordered).
  if [[ "$DATE" < "$FIRST_COMMIT_DATE" ]]; then
    OFFENDERS+=("$DATE")
  fi
done <<< "$ADDED_HEADINGS"

if [[ ${#OFFENDERS[@]} -eq 0 ]]; then
  exit 0
fi

# ----- Reject -----
{
  echo ""
  echo "============================================================"
  echo "  pre-commit BLOCKED: CHANGELOG.md fabricated date"
  echo "============================================================"
  echo ""
  echo "  First commit in this repo: ${FIRST_COMMIT_DATE}"
  echo "  Offending date(s) in new CHANGELOG entries:"
  for d in "${OFFENDERS[@]}"; do
    echo "    - ${d}   (predates first commit — impossible)"
  done
  echo ""
  echo "  Why this matters:"
  echo "    A CHANGELOG date earlier than the repo's first commit is"
  echo "    necessarily fabricated. Past agents have invented narrative"
  echo "    dates instead of checking git. This hook stops that at source."
  echo ""
  echo "  Fix:"
  echo "    - For 'today': use \$(date +%Y-%m-%d)"
  echo "    - For a past commit: git log --format=%cs <sha>"
  echo "    - Floor: any date >= ${FIRST_COMMIT_DATE} is acceptable."
  echo ""
  echo "  בעברית: התאריך שכתבת ב-CHANGELOG מוקדם מהקומיט הראשון"
  echo "  של הריפו (${FIRST_COMMIT_DATE}). זה תאריך מומצא. תקן ונסה שוב."
  echo "============================================================"
  echo ""
} >&2

exit 1
